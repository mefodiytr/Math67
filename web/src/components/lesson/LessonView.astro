---
import type { Lesson } from "@/lib/types.ts";
import { getModule } from "@/data/world.ts";
import DifficultyBadge from "./DifficultyBadge.astro";
import CuratorBadge from "./CuratorBadge.astro";
import Markdown from "./Markdown.astro";
import TaskCard from "./TaskCard.astro";
import LessonProgressBar from "./LessonProgressBar.astro";
import TaskInput from "@components/interactive/TaskInput.tsx";
import SelfCheck from "@components/interactive/SelfCheck.tsx";

interface Props {
  lesson: Lesson;
}
const { lesson } = Astro.props;
const mod = getModule(lesson.moduleId);

// Соседи
const prevId = lesson.lessonId > 1 ? lesson.lessonId - 1 : null;
const nextId =
  mod && lesson.lessonId < mod.lessonsCount ? lesson.lessonId + 1 : null;
const isFinal = mod && lesson.lessonId === mod.lessonsCount;

// Сколько всего «проверяемых» задач
let totalCheckable = 0;
for (const sec of lesson.sections) {
  for (const t of sec.tasks) {
    if (t.expectedAnswer) totalCheckable++;
  }
}
if (lesson.sphinx?.expectedAnswer) totalCheckable++;
---

<article class="space-y-8 pb-12">
  {/* Хлебные крошки */}
  <nav class="flex flex-wrap items-center gap-2 text-sm text-9m-fog">
    <a href="/" class="text-9m-fog no-underline hover:text-9m-silver">Карта</a>
    <span aria-hidden="true">›</span>
    <a
      href={`/module/${lesson.moduleId}`}
      class="text-9m-fog no-underline hover:text-9m-silver"
    >
      {mod?.shortTitle ?? `Модуль ${lesson.moduleId}`}
    </a>
    <span aria-hidden="true">›</span>
    <span class="text-9m-silver">Урок {lesson.moduleId}.{lesson.lessonId}</span>
  </nav>

  {/* Заголовок */}
  <header class="space-y-4">
    <div
      class="h-1 w-24 rounded-full"
      style={`background-color: ${mod?.primaryColour ?? "#E2E8F0"}`}
    >
    </div>
    <p class="text-xs uppercase tracking-[0.3em] text-9m-fog">
      Модуль {lesson.moduleId} · Урок {lesson.lessonId}
      {isFinal && <span class="ml-2 text-9m-gold">· Финал модуля</span>}
    </p>
    <h1 class="font-display text-3xl font-medium leading-tight text-9m-silver md:text-5xl">
      {lesson.shortTitle}
    </h1>
    <div class="flex flex-wrap items-center gap-3 text-sm text-9m-fog">
      {lesson.duration && <span>⏱ {lesson.duration} мин</span>}
      {mod?.shortTitle && (
        <span style={`color: ${mod.primaryColour}`}>● {mod.shortTitle}</span>
      )}
      {lesson.curator && <CuratorBadge curatorId={lesson.curator} />}
    </div>
  </header>

  {/* Прогресс-бар (показываем если есть задачи с проверкой) */}
  {
    totalCheckable > 0 && (
      <LessonProgressBar
        moduleId={lesson.moduleId}
        lessonId={lesson.lessonId}
        totalCount={totalCheckable}
      />
    )
  }

  {/* Сюжет */}
  {
    lesson.story && (
      <section class="paper">
        <h2 class="section-heading">Сюжет</h2>
        <Markdown text={lesson.story} />
      </section>
    )
  }

  {/* Идея */}
  {
    lesson.idea && (
      <section class="paper">
        <h2 class="section-heading">Идея</h2>
        <Markdown text={lesson.idea} />
      </section>
    )
  }

  {/* Задачи по уровням */}
  {
    lesson.sections.map((sec) => (
      <section class="paper">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <h2 class="section-heading m-0">
            {sec.heading.replace(/\(★+\)/g, "").replace(/★+/g, "").trim()}
          </h2>
          <DifficultyBadge level={sec.difficulty} />
        </div>
        {sec.tasks.length > 0 ? (
          <ol class="space-y-3">
            {sec.tasks.map((t) => (
              <TaskCard task={t} moduleId={lesson.moduleId} lessonId={lesson.lessonId} />
            ))}
          </ol>
        ) : (
          <p class="text-9m-fog">Без задач — текстовая часть.</p>
        )}
      </section>
    ))
  }

  {/* Sphinx Challenge */}
  {
    lesson.sphinx && (
      <section class="sphinx-block">
        <h2 class="mb-3 font-display text-2xl text-9m-gold">
          {lesson.sphinx.heading}
        </h2>
        <Markdown text={lesson.sphinx.text} />
        {lesson.sphinx.expectedAnswer ? (
          lesson.sphinx.answerType === "numeric" ||
          lesson.sphinx.answerType === "choice" ? (
            <TaskInput
              client:load
              moduleId={lesson.moduleId}
              lessonId={lesson.lessonId}
              taskNumber="sphinx"
              expectedAnswer={lesson.sphinx.expectedAnswer}
              answerType={lesson.sphinx.answerType}
            />
          ) : (
            <SelfCheck
              client:load
              moduleId={lesson.moduleId}
              lessonId={lesson.lessonId}
              taskNumber="sphinx"
              expectedAnswer={lesson.sphinx.expectedAnswer}
            />
          )
        ) : null}
      </section>
    )
  }

  {/* English block */}
  {
    lesson.english && (
      <section class="paper">
        <h2 class="section-heading flex items-center gap-2">
          <span class="text-9m-scarlet">🔔</span>
          English with the Bell Fairy
        </h2>
        <div class="english-block">
          <Markdown text={lesson.english.text} />
          {lesson.english.teacherTranslation && (
            <details class="mt-4 cursor-pointer text-9m-fog">
              <summary class="select-none font-medium">
                👀 Я учитель — показать перевод
              </summary>
              <p class="mt-2 italic text-9m-silver/80">
                {lesson.english.teacherTranslation}
              </p>
            </details>
          )}
        </div>
      </section>
    )
  }

  {/* Кошачий факт */}
  {
    lesson.catFact && (
      <section class="paper">
        <h2 class="section-heading">🐾 Кошачий факт</h2>
        <Markdown text={lesson.catFact} />
      </section>
    )
  }

  {/* Рефлексия */}
  {
    lesson.reflection && (
      <section class="paper">
        <h2 class="section-heading">Рефлексия</h2>
        <Markdown text={lesson.reflection} />
      </section>
    )
  }

  {/* Домашка */}
  {
    lesson.homework && (
      <section class="paper">
        <h2 class="section-heading">🌙 Домашний квест</h2>
        <Markdown text={lesson.homework} />
      </section>
    )
  }

  {/* Ответы под спойлером */}
  {
    lesson.answers && (
      <section class="paper">
        <details>
          <summary class="cursor-pointer select-none font-display text-lg text-9m-fog hover:text-9m-silver">
            🗝 Ответы (для проверки)
          </summary>
          <div class="mt-4">
            <Markdown text={lesson.answers} />
          </div>
        </details>
      </section>
    )
  }

  {/* Кнопка отметки прохождения */}
  <section class="paper">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-display text-lg text-9m-silver">
          {isFinal ? "Финал модуля пройден?" : "Урок пройден?"}
        </p>
        <p class="text-sm text-9m-fog">
          {
            isFinal
              ? "Загорится Луна модуля и появится артефакт в коллекции."
              : "Засчитается в прогресс модуля."
          }
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={`/teacher/lesson/${lesson.moduleId}/${lesson.lessonId}`}
          class="btn"
          title="Открыть страницу для учителя — дневник и шкалы"
        >
          👩‍🏫 Дневник учителя
        </a>
        <button
          id="mark-lesson-btn"
          class="btn"
          data-module-id={String(lesson.moduleId)}
          data-lesson-id={String(lesson.lessonId)}
          data-is-final={isFinal ? "true" : "false"}
        >
          ✓ Отметить пройденным
        </button>
      </div>
    </div>
    <p
      id="mark-lesson-status"
      class="mt-3 hidden text-sm text-9m-gold"
      role="status"
    >
    </p>
  </section>

  {/* Навигация */}
  <nav class="flex items-center justify-between gap-3 border-t border-9m-silver/10 pt-6">
    {
      prevId ? (
        <a href={`/lesson/${lesson.moduleId}/${prevId}`} class="btn">
          ← Назад
        </a>
      ) : (
        <span />
      )
    }
    <a href={`/module/${lesson.moduleId}`} class="btn">
      🗺 К модулю
    </a>
    {
      nextId ? (
        <a href={`/lesson/${lesson.moduleId}/${nextId}`} class="btn btn-primary">
          Следующий →
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</article>

<script>
  import {
    setLessonProgress,
    setModuleCompleted,
    getLessonProgress,
    loadProgress,
  } from "@lib/progress.ts";

  // ── Кнопка «отметить пройденным» ───────────────────
  const btn = document.getElementById("mark-lesson-btn") as HTMLButtonElement | null;
  const status = document.getElementById("mark-lesson-status");
  if (btn) {
    const moduleId = parseInt(btn.dataset.moduleId!, 10);
    const lessonId = parseInt(btn.dataset.lessonId!, 10);
    const isFinal = btn.dataset.isFinal === "true";

    const cur = getLessonProgress(moduleId, lessonId);
    if (cur?.completed) {
      btn.textContent = "✓ Урок пройден";
      btn.classList.add("border-9m-gold/60", "text-9m-gold");
      btn.disabled = true;
    }

    btn.addEventListener("click", () => {
      const wasCompleted = !!getLessonProgress(moduleId, lessonId)?.completed;
      setLessonProgress(moduleId, lessonId, {
        completed: true,
        percent: 100,
      });
      if (isFinal) {
        setModuleCompleted(moduleId);
        // Запоминаем «только что открыли» — для подсветки в коллекции и эмблеме
        try {
          sessionStorage.setItem("9moons.justUnlocked", String(moduleId));
        } catch {}
        // Триггерим церемонию (только если впервые)
        if (!wasCompleted) {
          window.dispatchEvent(
            new CustomEvent("9moons:ceremony", { detail: { moduleId } })
          );
        }
      }
      btn.textContent = "✓ Урок пройден";
      btn.classList.add("border-9m-gold/60", "text-9m-gold");
      btn.disabled = true;
      if (status) {
        status.classList.remove("hidden");
        status.textContent = isFinal
          ? "🌙 Луна модуля загорелась! Артефакт открыт в коллекции."
          : "Прогресс сохранён.";
      }
    });
  }

  // ── Подсветка карточек задач по статусу из localStorage ───────────────
  function paintTaskCards(): void {
    const data = loadProgress();
    document.querySelectorAll<HTMLElement>("[data-task-key]").forEach((el) => {
      const key = el.dataset.taskKey!;
      const t = data.tasks?.[key];
      el.classList.remove("is-correct", "is-wrong");
      if (!t) return;
      if (t.status === "correct") el.classList.add("is-correct");
      if (t.status === "wrong") el.classList.add("is-wrong");
    });
  }
  paintTaskCards();
  // Перерисовываем при кликах (после ответа в виджете)
  document.addEventListener("click", () => setTimeout(paintTaskCards, 100));
  window.addEventListener("storage", paintTaskCards);
</script>
