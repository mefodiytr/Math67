---
/**
 * Карточка одной задачи в уроке. По типу задачи рендерит:
 *  - <TaskInput>          для numeric / choice (auto-check + проверка)
 *  - <ExpressionInput>    для задач «расставь скобки/знаки» (ответ = выражение = число)
 *  - <SelfCheck>          для всего остального (proof, нарисуй, придумай и т.п.)
 */
import type { Task } from "@/lib/types.ts";
import Markdown from "./Markdown.astro";
import TaskInput from "@components/interactive/TaskInput.tsx";
import ExpressionInput from "@components/interactive/ExpressionInput.tsx";
import SelfCheck from "@components/interactive/SelfCheck.tsx";
import { parseExpressionTarget } from "@/lib/answers.ts";

interface Props {
  task: Task;
  moduleId: number;
  lessonId: number;
}
const { task, moduleId, lessonId } = Astro.props;

const useNumeric =
  task.expectedAnswer &&
  (task.answerType === "numeric" || task.answerType === "choice");

const useExpression =
  task.expectedAnswer && task.answerType === "expression";

const exprMeta = useExpression
  ? parseExpressionTarget(task.expectedAnswer!)
  : null;
---

<li
  class="task-card"
  data-task-key={`${moduleId}.${lessonId}.${task.number}`}
>
  <div class="flex gap-3">
    <span class="font-display text-9m-gold" aria-hidden="true">
      {task.number}.
    </span>
    <div class="flex-1">
      <Markdown text={task.text} />

      {
        useNumeric ? (
          <TaskInput
            client:load
            moduleId={moduleId}
            lessonId={lessonId}
            taskNumber={task.number}
            expectedAnswer={task.expectedAnswer!}
            answerType={task.answerType!}
          />
        ) : useExpression && exprMeta ? (
          <ExpressionInput
            client:load
            moduleId={moduleId}
            lessonId={lessonId}
            taskNumber={task.number}
            target={exprMeta.target}
            reveal={exprMeta.reveal}
          />
        ) : (
          <SelfCheck
            client:load
            moduleId={moduleId}
            lessonId={lessonId}
            taskNumber={task.number}
            expectedAnswer={task.expectedAnswer}
          />
        )
      }
    </div>
  </div>
</li>
