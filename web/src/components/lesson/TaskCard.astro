---
/**
 * Карточка одной задачи в уроке. По типу задачи рендерит:
 *  - <TaskInput>   для numeric / choice (auto-check + проверка)
 *  - <SelfCheck>   для всего остального — открытые задачи, доказательства,
 *                  «расставь скобки», «нарисуй», «придумай».
 *                  Поле для ответа + «Решила/Не получилось» + (опц.) показать решение.
 */
import type { Task } from "@/lib/types.ts";
import Markdown from "./Markdown.astro";
import TaskInput from "@components/interactive/TaskInput.tsx";
import SelfCheck from "@components/interactive/SelfCheck.tsx";

interface Props {
  task: Task;
  moduleId: number;
  lessonId: number;
}
const { task, moduleId, lessonId } = Astro.props;

const useNumeric =
  task.expectedAnswer &&
  (task.answerType === "numeric" || task.answerType === "choice");
---

<li
  class="task-card"
  data-task-key={`${moduleId}.${lessonId}.${task.number}`}
>
  <div class="flex gap-3">
    <span class="font-display text-9m-gold" aria-hidden="true">
      {task.number}.
    </span>
    <div class="flex-1">
      <Markdown text={task.text} />

      {
        useNumeric ? (
          <TaskInput
            client:load
            moduleId={moduleId}
            lessonId={lessonId}
            taskNumber={task.number}
            expectedAnswer={task.expectedAnswer!}
            answerType={task.answerType!}
          />
        ) : (
          <SelfCheck
            client:load
            moduleId={moduleId}
            lessonId={lessonId}
            taskNumber={task.number}
            expectedAnswer={task.expectedAnswer}
          />
        )
      }
    </div>
  </div>
</li>
