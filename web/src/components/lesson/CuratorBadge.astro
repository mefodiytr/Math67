---
/**
 * Бейдж куратора в шапке урока — аватар + имя + архетип.
 */
import { getCharacter } from "@/data/world.ts";
import CharacterAvatar from "@components/world/CharacterAvatar.astro";

interface Props {
  curatorId?: string;
}
const { curatorId } = Astro.props;
if (!curatorId) return null;
const char = getCharacter(curatorId);
if (!char) return null;
---

<div
  class="flex items-center gap-3 rounded-full border border-9m-silver/15 bg-9m-charcoal/40 py-1.5 pr-4 pl-1.5"
>
  <CharacterAvatar id={curatorId} size="sm" />
  <span class="text-sm">
    <span class="text-9m-silver">{char.nameRu}</span>
    <span class="text-9m-fog"> · {char.archetype}</span>
  </span>
</div>
