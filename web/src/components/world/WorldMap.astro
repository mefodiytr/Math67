---
/**
 * Карта мира Феликсии. SVG-схема 13 островов на индиго-небе.
 * - Острова кликабельны → /module/{id}.
 * - Текущий остров (loaded из localStorage) пульсирует.
 * - Sumi-e декор: облака, sumi-волны, звёзды.
 * - Hover-эффект: тонкое свечение.
 */
import { MODULES, ISLAND_POSITIONS } from "@/data/world.ts";
---

<div class="relative mx-auto w-full overflow-hidden rounded-xl border border-9m-silver/10 bg-9m-charcoal/40">
  <svg
    viewBox="0 0 1000 600"
    class="block h-auto w-full"
    role="img"
    aria-label="Карта мира Феликсии — 13 островов курса"
  >
    {/* Defs */}
    <defs>
      <radialGradient id="skyGradient" cx="50%" cy="0%" r="100%">
        <stop offset="0%" stop-color="#1E3A8A" stop-opacity="0.65" />
        <stop offset="60%" stop-color="#0F172A" stop-opacity="0.92" />
        <stop offset="100%" stop-color="#0F172A" stop-opacity="1" />
      </radialGradient>

      <radialGradient id="moonAura" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#E2E8F0" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#E2E8F0" stop-opacity="0" />
      </radialGradient>

      <filter id="islandGlow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="2" />
      </filter>
    </defs>

    {/* Фон-небо */}
    <rect width="1000" height="600" fill="url(#skyGradient)" />

    {/* Большой лунный ореол вверху */}
    <circle cx="850" cy="80" r="180" fill="url(#moonAura)" />
    <circle cx="850" cy="80" r="36" fill="#E2E8F0" fill-opacity="0.85" />
    <circle cx="862" cy="74" r="36" fill="#0F172A" fill-opacity="0.65" />

    {/* Sumi-e облака сверху */}
    <g fill="rgba(226,232,240,0.05)" filter="url(#softShadow)">
      <ellipse cx="200" cy="60" rx="120" ry="14" />
      <ellipse cx="500" cy="80" rx="160" ry="12" />
      <ellipse cx="120" cy="180" rx="80" ry="8" />
    </g>

    {/* Sumi-e волна снизу */}
    <path
      d="M 0 540 Q 250 510 500 535 T 1000 530 L 1000 600 L 0 600 Z"
      fill="rgba(226,232,240,0.04)"
    />
    <path
      d="M 0 560 Q 200 545 400 555 T 1000 555 L 1000 600 L 0 600 Z"
      fill="rgba(226,232,240,0.06)"
    />

    {/* Звёзды */}
    <g fill="#E2E8F0">
      {[
        [80, 60, 0.8],
        [320, 40, 1],
        [560, 70, 0.6],
        [780, 50, 0.9],
        [60, 100, 0.5],
        [180, 280, 0.6],
        [630, 300, 0.8],
        [940, 430, 0.7],
        [50, 320, 0.4],
        [990, 250, 0.5],
        [400, 60, 0.5],
        [720, 90, 0.4],
      ].map(([cx, cy, r]) => (
        <circle cx={cx} cy={cy} r={r} opacity={0.5}>
          <animate
            attributeName="opacity"
            values="0.3;0.7;0.3"
            dur={`${3 + (Number(cx) % 3)}s`}
            repeatCount="indefinite"
          />
        </circle>
      ))}
    </g>

    {/* Соединительные пунктирные линии: путь Лены через 13 островов */}
    <g
      stroke="rgba(226,232,240,0.18)"
      stroke-width="1.5"
      stroke-dasharray="4 6"
      fill="none"
    >
      {
        MODULES.slice(0, -1).map((m, idx) => {
          const a = ISLAND_POSITIONS[m.id];
          const b = ISLAND_POSITIONS[MODULES[idx + 1].id];
          if (!a || !b) return null;
          return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />;
        })
      }
    </g>

    {/* Острова */}
    {
      MODULES.map((m) => {
        const pos = ISLAND_POSITIONS[m.id];
        if (!pos) return null;
        return (
          <a href={`/module/${m.id}`} class="island-link" data-module={m.id}>
            <g transform={`translate(${pos.x},${pos.y})`} filter="url(#islandGlow)">
              <circle
                r="36"
                fill={m.primaryColour}
                fill-opacity="0.1"
                stroke={m.primaryColour}
                stroke-opacity="0.5"
                stroke-width="1.5"
                class="island-aura"
              />
              <circle
                r="26"
                fill={m.primaryColour}
                fill-opacity="0.2"
                stroke={m.primaryColour}
                stroke-width="2"
                class="island-circle"
              />
              <circle
                r="18"
                fill={m.primaryColour}
                fill-opacity="0.5"
                class="island-inner"
              />
              <text
                text-anchor="middle"
                dominant-baseline="central"
                font-size="14"
                font-weight="600"
                class="fill-9m-charcoal pointer-events-none"
              >
                {m.id}
              </text>
              <text
                text-anchor="middle"
                y="58"
                font-size="11"
                class="fill-9m-silver pointer-events-none"
                style="filter: drop-shadow(0 1px 2px rgba(15,23,42,0.9));"
              >
                {m.shortTitle}
              </text>
            </g>
          </a>
        );
      })
    }
  </svg>
</div>

<style>
  .island-link {
    cursor: pointer;
  }
  .island-link .island-circle,
  .island-link .island-inner,
  .island-link .island-aura {
    transition: fill-opacity 0.25s ease, transform 0.25s ease, r 0.25s ease;
  }
  .island-link:hover .island-circle {
    fill-opacity: 0.4;
  }
  .island-link:hover .island-inner {
    fill-opacity: 0.85;
  }
  .island-link:hover .island-aura {
    fill-opacity: 0.18;
  }
  .island-link:focus-visible {
    outline: none;
  }
  .island-link:focus-visible .island-circle {
    stroke-dasharray: 3 3;
  }
  /* Текущий остров — пульсация. */
  .island-link[data-current="true"] .island-aura {
    animation: pulse-aura 2.5s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  @keyframes pulse-aura {
    0%, 100% {
      fill-opacity: 0.1;
    }
    50% {
      fill-opacity: 0.35;
    }
  }
</style>

<script>
  /**
   * Подсветить текущий остров (по последнему открытому уроку)
   * — добавляем data-current="true" на нужный <a>.
   */
  import { loadProgress } from "@lib/progress.ts";

  function markCurrent(): void {
    const data = loadProgress();
    document.querySelectorAll<SVGAElement>(".island-link").forEach((a) => {
      a.removeAttribute("data-current");
    });
    const cur = data.currentLesson;
    if (!cur) return;
    const target = document.querySelector<SVGAElement>(
      `.island-link[data-module="${cur.moduleId}"]`
    );
    if (target) target.setAttribute("data-current", "true");
  }
  markCurrent();
  window.addEventListener("focus", markCurrent);
</script>
