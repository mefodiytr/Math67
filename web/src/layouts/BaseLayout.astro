---
import "@/styles/globals.css";
import EmblemCorner from "@components/world/EmblemCorner.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Академия Девяти Лун — курс математики 6+ для Лены" } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F172A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Академия Девяти Лун</title>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-9m-charcoal focus:px-3 focus:py-2 focus:text-9m-silver">
      Перейти к содержимому
    </a>

    <header class="sticky top-0 z-30 border-b border-9m-silver/10 bg-9m-charcoal/70 backdrop-blur-md">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 text-sm">
        <a href="/" class="flex items-center gap-2 text-9m-silver no-underline transition-colors hover:text-9m-gold">
          <span class="text-lg">🌙</span>
          <span class="font-display tracking-wide">Академия Девяти Лун</span>
        </a>
        <div class="flex items-center gap-4">
          <a href="/" class="text-9m-fog no-underline hover:text-9m-silver">Карта</a>
          <a href="/progress" class="text-9m-fog no-underline hover:text-9m-silver">Прогресс</a>
          <a href="/collection" class="text-9m-fog no-underline hover:text-9m-silver">Коллекция</a>
          <a href="/teacher" class="text-9m-fog no-underline hover:text-9m-silver">Учитель</a>
        </div>
      </nav>
    </header>

    <main id="main" class="relative mx-auto max-w-7xl px-4 py-8">
      <slot />
    </main>

    <EmblemCorner />

    <footer class="mt-16 border-t border-9m-silver/10 py-6 text-center text-xs text-9m-fog">
      <p>
        <span class="font-display">Академия Девяти Лун</span> · курс для Лены ·
        <a
          href="https://github.com/mefodiytr/math67"
          class="text-9m-fog hover:text-9m-silver"
          target="_blank"
          rel="noopener"
        >
          source
        </a>
      </p>
    </footer>
  </body>
</html>
