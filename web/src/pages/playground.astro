---
import BaseLayout from "@layouts/BaseLayout.astro";
import FractionVisual from "@components/interactive/FractionVisual.tsx";
import NumberLine from "@components/interactive/NumberLine.tsx";
import CoordinatePlane from "@components/interactive/CoordinatePlane.tsx";
import FunctionSlider from "@components/interactive/FunctionSlider.tsx";
import TruthTable from "@components/interactive/TruthTable.tsx";
import ProbabilityTree from "@components/interactive/ProbabilityTree.tsx";
---

<BaseLayout title="Виджеты — демо">
  <header class="mb-8 space-y-2">
    <p class="text-sm uppercase tracking-[0.3em] text-9m-fog">Playground</p>
    <h1 class="font-display text-4xl font-medium text-9m-silver">
      Интерактивные виджеты
    </h1>
    <p class="text-9m-fog">
      Все встраиваются в уроки. Здесь — наглядная демонстрация каждого.
    </p>
  </header>

  {/* FractionVisual */}
  <section class="paper my-8">
    <h2 class="section-heading">Дроби — пирог и полоска</h2>
    <p class="mb-3 text-sm text-9m-fog">
      Модуль 1. Закрась нужное количество секторов.
    </p>

    <h3 class="mt-6 font-display text-lg text-9m-silver">Show: 3/8</h3>
    <FractionVisual den={8} num={3} mode="show" shape="pie" client:load />

    <h3 class="mt-6 font-display text-lg text-9m-silver">
      Answer: закрась 5 из 8
    </h3>
    <FractionVisual
      den={8}
      numTarget={5}
      mode="answer"
      shape="bar"
      label="Закрась 5/8 полоски"
      client:load
    />
  </section>

  {/* NumberLine */}
  <section class="paper my-8">
    <h2 class="section-heading">Числовая прямая</h2>
    <p class="mb-3 text-sm text-9m-fog">
      Модуль 1, 3. Ставь точки. Поддерживает дроби (через step).
    </p>

    <h3 class="mt-6 font-display text-lg text-9m-silver">Show: −2, 0.5, 3</h3>
    <NumberLine min={-5} max={5} step={1} marks={[-2, 0.5, 3]} mode="show" client:load />

    <h3 class="mt-6 font-display text-lg text-9m-silver">
      Answer: отметь точку 1.5
    </h3>
    <NumberLine
      min={0}
      max={4}
      step={0.5}
      target={1.5}
      mode="answer"
      label="Кликни в место, где должно быть 1.5"
      client:load
    />
  </section>

  {/* CoordinatePlane */}
  <section class="paper my-8">
    <h2 class="section-heading">Координатная плоскость</h2>
    <p class="mb-3 text-sm text-9m-fog">
      Модуль 5, 12. Кликни в нужную точку — проверяется по координатам.
    </p>

    <h3 class="mt-6 font-display text-lg text-9m-silver">
      Show: A(2,3), B(−1,2), C(−2,−1)
    </h3>
    <CoordinatePlane
      points={[
        { x: 2, y: 3, label: "A" },
        { x: -1, y: 2, label: "B" },
        { x: -2, y: -1, label: "C" },
      ]}
      mode="show"
      client:load
    />

    <h3 class="mt-6 font-display text-lg text-9m-silver">
      Answer: поставь точку (−3, 2)
    </h3>
    <CoordinatePlane
      target={{ x: -3, y: 2 }}
      mode="point"
      label="Кликни на точку с координатами (−3, 2)"
      client:load
    />
  </section>

  {/* FunctionSlider */}
  <section class="paper my-8">
    <h2 class="section-heading">Парабола y = ax² + bx + c</h2>
    <p class="mb-3 text-sm text-9m-fog">
      Модуль 12, урок 14. Крути слайдеры — кривая отзывается.
    </p>

    <FunctionSlider
      type="quadratic"
      initialA={1}
      initialB={0}
      initialC={-1}
      label="Двигай слайдеры. Заметь: вершина = (−b/2a, ...)"
      client:load
    />

    <h3 class="mt-6 font-display text-lg text-9m-silver">
      Линейная: y = kx + b
    </h3>
    <FunctionSlider
      type="linear"
      initialA={1}
      initialB={0}
      label="Найди такие k и b, чтобы прямая проходила через (0, 2) и (1, 5)."
      client:load
    />
  </section>

  {/* TruthTable */}
  <section class="paper my-8">
    <h2 class="section-heading">Таблица истинности</h2>
    <p class="mb-3 text-sm text-9m-fog">
      Модуль 11. Заполни столбцы со звёздочкой (*).
    </p>

    <TruthTable
      vars={["A", "B"]}
      columns={[
        { name: "A∧B", values: [0, 0, 0, 1] },
        { name: "A∨B", values: [0, 1, 1, 1] },
        { name: "¬A", values: [1, 1, 0, 0] },
      ]}
      fillIn={[0, 1, 2]}
      label="Заполни таблицу для A∧B, A∨B, ¬A"
      client:load
    />
  </section>

  {/* ProbabilityTree */}
  <section class="paper my-8">
    <h2 class="section-heading">Дерево вероятностей</h2>
    <p class="mb-3 text-sm text-9m-fog">
      Модуль 9. Иллюстрирует пути и P(пути) = произведение.
    </p>

    <h3 class="mt-6 font-display text-lg text-9m-silver">
      Две монеты — все 4 исхода
    </h3>
    <ProbabilityTree
      branches={[
        {
          label: "О",
          p: 0.5,
          children: [
            { label: "О", p: 0.5 },
            { label: "Р", p: 0.5 },
          ],
        },
        {
          label: "Р",
          p: 0.5,
          children: [
            { label: "О", p: 0.5 },
            { label: "Р", p: 0.5 },
          ],
        },
      ]}
      highlightPaths={[
        ["О", "О"],
        ["О", "Р"],
        ["Р", "О"],
      ]}
      label="Подсвечены пути «хотя бы один орёл». Сумма = 3/4."
      client:load
    />
  </section>

  <p class="mt-12 text-center text-sm text-9m-fog">
    Эти виджеты будут вставляться в конкретные уроки в Phase 5+.
  </p>
</BaseLayout>
