---
import BaseLayout from "@layouts/BaseLayout.astro";
import CharacterAvatar from "@components/world/CharacterAvatar.astro";
import { MODULES, getModule, getCharacter, getArtifact, getLocation } from "@/data/world.ts";
import { loadModule } from "@/lib/parse-lesson.ts";
import { assetUrl } from "@/lib/assets.ts";

export function getStaticPaths() {
  return MODULES.map((m) => ({ params: { mid: String(m.id) } }));
}

const { mid } = Astro.params;
const moduleId = parseInt(mid!, 10);
const mod = getModule(moduleId);
if (!mod) {
  return Astro.redirect("/");
}

const lessons = loadModule(moduleId);
const curator = mod.primaryCuratorId ? getCharacter(mod.primaryCuratorId) : undefined;
const artifact = mod.artifactId ? getArtifact(mod.artifactId) : undefined;
const location = getLocation(mod.locationId);
const locationBg = assetUrl("locations", mod.locationId);

// Соседние модули
const prevMod = moduleId > 0 ? getModule(moduleId - 1) : undefined;
const nextMod = moduleId < 12 ? getModule(moduleId + 1) : undefined;
---

<BaseLayout title={mod.shortTitle}>
  <nav class="mb-4 flex items-center gap-2 text-sm text-9m-fog">
    <a href="/" class="text-9m-fog no-underline hover:text-9m-silver">Карта</a>
    <span aria-hidden="true">›</span>
    <span class="text-9m-silver">Модуль {mod.id}</span>
  </nav>

  {/* HERO с фоном-локацией */}
  <header
    class="relative mb-8 overflow-hidden rounded-xl border border-9m-silver/10"
    style={`box-shadow: inset 0 0 60px ${mod.primaryColour}33`}
  >
    {/* Фон-локация (если PNG есть). Через CSS background-image, чтобы fallback не ломал layout. */}
    <div
      class="absolute inset-0 bg-cover bg-center opacity-20"
      style={`background-image: url('${locationBg}')`}
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0"
      style={`background: linear-gradient(180deg, transparent 0%, rgba(15,23,42,0.85) 100%), radial-gradient(at top right, ${mod.primaryColour}33 0%, transparent 60%)`}
      aria-hidden="true"
    >
    </div>

    <div class="relative space-y-3 p-6 md:p-10">
      <p class="text-xs uppercase tracking-[0.3em] text-9m-fog">
        Модуль {mod.id} · {location?.nameRu ?? mod.shortTitle}
      </p>
      <h1
        class="font-display text-4xl font-medium leading-tight md:text-5xl"
        style={`color: ${mod.primaryColour}`}
      >
        {mod.shortTitle}
      </h1>
      <p class="max-w-2xl text-lg text-9m-silver/85">{mod.title}</p>
      <p class="max-w-2xl text-9m-silver/70">{mod.tagline}</p>

      <div class="flex flex-wrap items-center gap-3 pt-3 text-sm">
        <span class="rounded-full border border-9m-silver/15 bg-9m-charcoal/30 px-3 py-1 text-9m-fog">
          {mod.lessonsCount} уроков
        </span>
        {
          artifact && (
            <span
              class="rounded-full border bg-9m-charcoal/30 px-3 py-1"
              style={`border-color: ${artifact.colour}66; color: ${artifact.colour}`}
            >
              🌙 {artifact.nameRu}
            </span>
          )
        }
        {
          curator && (
            <span class="rounded-full border border-9m-silver/15 bg-9m-charcoal/30 px-3 py-1 text-9m-fog">
              👤 {curator.nameRu}
            </span>
          )
        }
      </div>
    </div>
  </header>

  {/* Куратор */}
  {
    curator && (
      <section class="paper mb-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
          <CharacterAvatar id={curator.id} size="lg" />
          <div class="flex-1">
            <p class="text-xs uppercase tracking-widest text-9m-fog">Куратор модуля</p>
            <h2 class="font-display text-2xl text-9m-silver">{curator.nameRu}</h2>
            <p class="text-9m-fog">{curator.archetype}</p>
          </div>
        </div>
      </section>
    )
  }

  {/* Список уроков */}
  <section>
    <h2 class="section-heading mb-6">Уроки</h2>
    {
      lessons.length === 0 ? (
        <p class="text-9m-fog">
          Уроки этого модуля ещё не добавлены в систему.
        </p>
      ) : (
        <ol class="space-y-2">
          {lessons.map((l) => (
            <li>
              <a
                href={`/lesson/${l.moduleId}/${l.lessonId}`}
                class="task-card flex items-start gap-4 no-underline transition-all hover:translate-x-0.5"
                data-lesson-key={`${l.moduleId}.${l.lessonId}`}
              >
                <span
                  class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full font-display text-sm font-medium text-9m-charcoal"
                  style={`background-color: ${mod.primaryColour}`}
                >
                  {l.lessonId}
                </span>
                <div class="flex-1">
                  <h3 class="font-display text-lg text-9m-silver">
                    {l.shortTitle}
                  </h3>
                  <div class="mt-1 flex flex-wrap gap-3 text-xs text-9m-fog">
                    {l.duration && <span>⏱ {l.duration} мин</span>}
                    {l.sections.length > 0 && <span>{l.sections.length} секций задач</span>}
                    {l.sphinx && <span class="text-9m-gold">★★★★ Sphinx</span>}
                    {l.english && <span class="text-9m-scarlet">🔔 English</span>}
                  </div>
                </div>
                <span class="hidden text-9m-fog sm:block" data-lesson-status>→</span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  {/* Навигация между модулями */}
  <nav class="mt-12 flex items-center justify-between border-t border-9m-silver/10 pt-6">
    {
      prevMod ? (
        <a href={`/module/${prevMod.id}`} class="btn">
          ← Модуль {prevMod.id}
        </a>
      ) : (
        <span />
      )
    }
    <a href="/" class="btn">🗺 Карта</a>
    {
      nextMod ? (
        <a href={`/module/${nextMod.id}`} class="btn">
          Модуль {nextMod.id} →
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</BaseLayout>

<script>
  /**
   * Помечаем посещённые / решённые уроки в списке.
   */
  import { loadProgress } from "@lib/progress.ts";
  const data = loadProgress();
  document.querySelectorAll<HTMLAnchorElement>("[data-lesson-key]").forEach((el) => {
    const key = el.dataset.lessonKey!;
    const lp = data.lessons[key];
    if (lp) {
      const status = el.querySelector<HTMLElement>("[data-lesson-status]");
      if (lp.completed && status) {
        status.textContent = "✓";
        status.classList.add("text-9m-gold");
      } else if (lp.lastVisited && status) {
        status.textContent = "•";
        status.classList.add("text-9m-teal");
      }
    }
  });
</script>
