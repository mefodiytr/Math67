---
import BaseLayout from "@layouts/BaseLayout.astro";
import { ARTIFACTS } from "@/data/world.ts";
---

<BaseLayout title="Коллекция">
  <header class="mb-8 space-y-2">
    <p class="text-sm uppercase tracking-[0.3em] text-9m-fog">Артефакты Лены</p>
    <h1 class="font-display text-4xl font-medium text-9m-silver">Коллекция</h1>
    <p class="text-9m-fog">
      9 Лунных Камней, Перо Адепта, Кристалл Аксиом и Печать.
      Артефакт открывается после финала своего модуля.
    </p>
  </header>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="artifact-grid">
    {
      ARTIFACTS.map((a) => (
        <div
          class="task-card relative overflow-hidden"
          data-artifact={a.id}
          data-module={a.fromModule}
        >
          <div
            class="absolute inset-x-0 top-0 h-1"
            style={`background-color: ${a.colour}`}
          />
          <div class="flex items-start justify-between gap-3 pt-2">
            <div>
              <p class="text-xs uppercase tracking-widest text-9m-fog">
                Модуль {a.fromModule}
              </p>
              <h3 class="font-display text-lg text-9m-silver">{a.nameRu}</h3>
            </div>
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full opacity-30 transition-opacity"
              style={`background-color: ${a.colour}; color: ${a.colour}`}
              data-artifact-icon
            >
              <span class="text-2xl">🌙</span>
            </div>
          </div>
          <p class="mt-3 text-sm text-9m-fog" data-artifact-status>
            Не открыт
          </p>
        </div>
      ))
    }
  </section>
</BaseLayout>

<script>
  import { loadProgress } from "@lib/progress.ts";

  const data = loadProgress();
  document.querySelectorAll<HTMLElement>("[data-artifact]").forEach((el) => {
    const moduleId = el.dataset.module;
    if (!moduleId) return;
    const completed = data.modules[moduleId]?.completed;
    const status = el.querySelector<HTMLElement>("[data-artifact-status]");
    const icon = el.querySelector<HTMLElement>("[data-artifact-icon]");
    if (completed) {
      el.classList.add("ring-1", "ring-9m-gold/40");
      if (status) {
        status.textContent = "✓ Получен";
        status.classList.add("text-9m-gold");
      }
      if (icon) icon.classList.replace("opacity-30", "opacity-100");
    }
  });
</script>
