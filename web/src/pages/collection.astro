---
import BaseLayout from "@layouts/BaseLayout.astro";
import { ARTIFACTS, getModule } from "@/data/world.ts";
import { assetUrl, placeholderSVG } from "@/lib/assets.ts";
---

<BaseLayout title="Коллекция">
  <header class="mb-8 space-y-2">
    <p class="text-sm uppercase tracking-[0.3em] text-9m-fog">
      Артефакты Лены
    </p>
    <h1 class="font-display text-4xl font-medium text-9m-silver">Коллекция</h1>
    <p class="text-9m-fog">
      9 Лунных Камней, Перо Адепта, Кристалл Аксиом и Печать.
      Артефакт открывается после финала своего модуля.
    </p>
  </header>

  {/* Баннер «Сертификат готов» — показывается, если Модуль 12 завершён */}
  <div
    id="cert-banner"
    class="paper mb-6 hidden border-l-4 border-9m-gold bg-9m-gold/5"
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-display text-xl text-9m-gold">
          🌙 Сертификат Адепта готов
        </p>
        <p class="text-sm text-9m-silver/80">
          Все 9 Лун + Перо + Кристалл + Печать. Можно открыть и распечатать.
        </p>
      </div>
      <a href="/certificate" class="btn btn-primary">
        Открыть сертификат →
      </a>
    </div>
  </div>

  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" id="artifact-grid">
    {
      ARTIFACTS.map((a) => {
        const mod = getModule(a.fromModule);
        const fallback = placeholderSVG(a.nameRu, a.colour);
        const png = assetUrl("artifacts", a.id);
        return (
          <div
            class="task-card relative overflow-hidden transition-all"
            data-artifact={a.id}
            data-module={a.fromModule}
          >
            {/* Цветная полоска сверху */}
            <div
              class="absolute inset-x-0 top-0 h-1"
              style={`background-color: ${a.colour}`}
            />

            <div class="flex items-start justify-between gap-3 pt-2">
              <div class="flex-1">
                <p class="text-xs uppercase tracking-widest text-9m-fog">
                  Модуль {a.fromModule} · {mod?.shortTitle}
                </p>
                <h3 class="font-display text-lg text-9m-silver">{a.nameRu}</h3>
              </div>
              <div
                class="relative flex h-16 w-16 shrink-0 items-center justify-center rounded-full transition-opacity"
                data-artifact-icon
              >
                <img
                  src={png}
                  data-fallback={fallback}
                  alt={a.nameRu}
                  loading="lazy"
                  class="h-full w-full rounded-full object-contain opacity-30 grayscale transition-all duration-500"
                  onerror="if(this.src!==this.dataset.fallback){this.src=this.dataset.fallback;}"
                />
              </div>
            </div>
            <p class="mt-3 text-sm text-9m-fog" data-artifact-status>
              Не открыт
            </p>
          </div>
        );
      })
    }
  </section>
</BaseLayout>

<script>
  import { loadProgress } from "@lib/progress.ts";

  function paintCollection(): void {
    const data = loadProgress();
    let justUnlocked: string | null = null;
    try {
      justUnlocked = sessionStorage.getItem("9moons.justUnlocked");
    } catch {}

    document.querySelectorAll<HTMLElement>("[data-artifact]").forEach((el) => {
      const moduleId = el.dataset.module;
      if (!moduleId) return;
      const completed = data.modules?.[moduleId]?.completed;
      const status = el.querySelector<HTMLElement>("[data-artifact-status]");
      const img = el.querySelector<HTMLImageElement>("img");
      if (completed) {
        el.classList.add("ring-1", "ring-9m-gold/40");
        if (status) {
          status.textContent = "✓ Получен";
          status.classList.add("text-9m-gold");
          status.classList.remove("text-9m-fog");
        }
        if (img) {
          img.classList.remove("opacity-30", "grayscale");
          img.classList.add("opacity-100");
        }
        // Свежий артефакт — анимация
        if (justUnlocked === moduleId) {
          el.classList.add("animate-pop", "ring-2", "ring-9m-gold");
          el.style.boxShadow = `0 0 32px rgba(245,158,11,0.35)`;
          // снимаем флаг чтобы не повторялось
          try {
            sessionStorage.removeItem("9moons.justUnlocked");
          } catch {}
        }
      }
    });
  }

  paintCollection();
  window.addEventListener("storage", paintCollection);
  window.addEventListener("focus", paintCollection);

  // Баннер сертификата
  function refreshBanner(): void {
    const data = loadProgress();
    const banner = document.getElementById("cert-banner");
    if (!banner) return;
    if (data.modules?.["12"]?.completed) {
      banner.classList.remove("hidden");
    } else {
      banner.classList.add("hidden");
    }
  }
  refreshBanner();
  window.addEventListener("focus", refreshBanner);
  window.addEventListener("storage", refreshBanner);
</script>
